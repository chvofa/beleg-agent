# .envrc — wird von direnv geladen, wenn man in dieses Verzeichnis cd'd.
#
# Laedt ANTHROPIC_API_KEY aus dem macOS-Keychain. Der Login-Keychain ist
# beim Anmelden automatisch unlocked, deshalb gibt es zur Laufzeit nie
# einen Master-Password-Prompt.
#
# Einmaliges Setup (Wert eintragen oder rotieren):
#   security add-generic-password -s beleg_agent -a ANTHROPIC_API_KEY -U -w "sk-ant-..."
#
# Loeschen:
#   security delete-generic-password -s beleg_agent -a ANTHROPIC_API_KEY
#
# Nach Aenderung dieser Datei: `direnv allow`

if [ "$(uname)" != "Darwin" ]; then
    return 0  # Linux/Windows: ANTHROPIC_API_KEY muss extern gesetzt sein
fi

if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    _k="$(security find-generic-password -s beleg_agent -a ANTHROPIC_API_KEY -w 2>/dev/null || true)"
    if [ -n "$_k" ]; then
        export ANTHROPIC_API_KEY="$_k"
    else
        log_error "ANTHROPIC_API_KEY nicht im Keychain. Setup:"
        log_error '  security add-generic-password -s beleg_agent -a ANTHROPIC_API_KEY -U -w "sk-ant-..."'
    fi
    unset _k
fi
